# For running the stack LOCALLY with Docker (cp env.example .env). On AWS, Terraform + SSM generate this file for you.
SITE_URL=http://localhost
SITE_ADDRESS=:80

MONGO_ROOT_PASSWORD=change_me_alnum_only

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

REPORT_SIGNING_KEY=long_random_string
GROQ_API_KEY=

# e-mail: leave dry-run on locally
SMTP_DRY_RUN=true
